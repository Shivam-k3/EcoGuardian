# Supabase client config (Phase 2). Only the publishable/anonymous key is used
# client-side; the secret key and DATABASE_URL must NEVER go into the frontend.
VITE_SUPABASE_URL=https://tudkepbppaucnspxpfbg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key

# Deployed Express backend origin (Render). REQUIRED in production: without it
# API calls are same-origin relative (/api) and Vercel returns 404. The /api
# suffix is appended automatically if omitted. Leave unset locally — the Vite
# dev server proxies /api to http://localhost:5000.
# VITE_API_URL=https://replace_with_render_backend_url
